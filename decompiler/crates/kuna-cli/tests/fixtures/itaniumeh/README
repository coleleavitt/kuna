eh_x86_64.elf:      g++ -O2 -fno-reorder-blocks-and-partition -fno-pie -no-pie -Wl,--build-id=none -o eh_x86_64.elf eh.cc; strip --strip-debug
eh_x86_64_cold.elf: g++ -O2 -fno-pie -no-pie -o eh_x86_64_cold.elf eh.cc; strip --strip-debug
eh_aarch64.so:      clang++ --target=aarch64-linux-gnu -O2 -fPIC -c eh2.cc -o eh2.o; ld.lld -shared -o eh_aarch64.so eh2.o
