<stringmatch name="OBJCSDKVARARGS #1: without headers stringWithFormat: has no format arguments" min="1" max="1">objc_msgSend\$stringWithFormat:\(classRef_Fmt\);</stringmatch>
<stringmatch name="OBJCSDKVARARGS #2: with headers stringWithFormat: keeps its format and takes both stack arguments" min="1" max="1">objc_msgSend\$stringWithFormat:\(classRef_Fmt,\(NSString \*\)"%s=%ld",a1,a2\);</stringmatch>
<stringmatch name="OBJCSDKVARARGS #3: with headers logLevel:format: keeps its two fixed arguments and takes both stack arguments" min="1" max="1">objc_msgSend\$logLevel:format:\(a0,2,"%s has %ld",a1,a2\);</stringmatch>
