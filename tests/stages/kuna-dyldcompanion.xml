<decompilertest>
<binaryimage arch="AARCH64:LE:64:v8A:default">
<!--
    dyld shared cache companion images (`option dyldimage A+B`).

    A rebuilt cache image held one image's code: a call into another image
    was named, but the callee itself could not be loaded or decompiled in the
    same program. Naming companions after the primary image (`+`-separated)
    adds their segments, their symbols (as locals) and the names of their own
    calls to the rebuilt Mach-O, so the session spans several images.

    Stage / sub-stage: P1 environment-binding, the dyld cache rebuild
    (`kuna_dyldcache/extract.rs (DyldCache::extract_with)`), inside
    `load file`; `option dyldimage` is set before `load file`.

    Pass 1 (`dyldimage /usr/lib/libcaller.dylib`, the BUG): libcallee's
    `callee_add` is not in the program's function list. Pass 2
    (`dyldimage /usr/lib/libcaller.dylib+libcallee`, the FIX): it decompiles,
    and the primary's call into it keeps its import name.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c0035fd6
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>option dyldimage /usr/lib/libcaller.dylib</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dyld_cache_arm64e/dyld_shared_cache_arm64e</com>
  <com>read symbols</com>
  <com>functions</com>
  <com>option dyldimage /usr/lib/libcaller.dylib+libcallee</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dyld_cache_arm64e/dyld_shared_cache_arm64e</com>
  <com>read symbols</com>
  <com>functions</com>
  <com>load function callee_add</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function caller_entry</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="dyldcompanion #1: only the merged pass lists the companion's function" min="1" max="1">0x180002800 _callee_add</stringmatch>
<stringmatch name="dyldcompanion #2: with the companion the callee decompiles" min="1" max="1">return a0 \+ a1;</stringmatch>
<stringmatch name="dyldcompanion #3: the primary's call keeps its import name" min="1" max="1">v1 = callee_entry\(\);</stringmatch>
</decompilertest>
