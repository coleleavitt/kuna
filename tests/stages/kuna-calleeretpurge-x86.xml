<script>
  <com>option calleeretpurge off</com>
  <com>lo fu use</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleeretpurge on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
