</bytechunk>
<symbol space="ram" offset="0x100000" name="dispatch"/>
<symbol space="ram" offset="0x100078" name="g"/>
<symbol space="ram" offset="0x100084" name="sink"/>
</binaryimage>
<script>
  <com>parse line extern void sink(int4 v);</com>
  <com>parse line extern void g(int4 v);</com>
  <com>lo fu dispatch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option switchtrim off</com>
  <com>lo fu dispatch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="relswitch #1: the hardened table is a switch on the clamped index, with or without switchtrim" min="2" max="2">switch\(.* &gt;&gt; 0x3e\)</stringmatch>
<stringmatch name="relswitch #2: every case is recovered" min="2" max="2">case 3:</stringmatch>
<stringmatch name="relswitch #3: no computed jump remains" min="0" max="0">jump-as-call</stringmatch>
<stringmatch name="relswitch #4: case 1 passes a1 + 5 to sink" min="2" max="2">sink\(.* \+ 5\)</stringmatch>
</decompilertest>
