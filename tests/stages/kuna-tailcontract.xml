<script>
  <com>option tailcontract off</com>
  <com>lo fu thunk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pass</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option tailcontract on</com>
  <com>lo fu thunk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pass</com>
  <com>decompile</com>
  <com>print C</com>
