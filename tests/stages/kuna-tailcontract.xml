<stringmatch name="TAILCONTRACT #1: off, the thunk's tail call result is dropped" min="1" max="1">^  target\(a0,0\); // tail-call$</stringmatch>
<stringmatch name="TAILCONTRACT #2: on, the thunk returns the tail call's result" min="1" max="1">^  return target\(a0,(NULL|0)\); // tail-call$</stringmatch>
<stringmatch name="TAILCONTRACT #3: off, the forwarder drops the argument it passes through" min="1" max="1">^  helper\(a0,a1 \+ 1\); // tail-call$</stringmatch>
