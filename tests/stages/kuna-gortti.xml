<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna (IDA 9.5 golang plugin: moduledata layouts per release, type and itab
    naming): P1 external refinement, option gortti (default on). The script
    loads the committed gortti/shapes_go116 and gortti/shapes_go126 (stripped
    go1.16.15 and go1.26.2 builds of main.go beside them). main.mk allocates a
    main.Point; main.main converts the *main.Point to the main.Shape interface.

    runtime.moduledata is read through the layout row of each release (go1.16
    and go1.26 sit at the two ends of the table), the type graph is walked from
    typelinks and itablinks, and each descriptor gets its linker name.

    Assert #1 is the off pass: newobject takes a bare address (once per image).
    Asserts #2-#5 are the on pass: the go1.16 image uses the old linker
    spelling (`type.`, `go.itab.`), the go1.26 image the colon spelling.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/gortti/shapes_go116</com>
  <com>option gortti off</com>
  <com>read symbols</com>
  <com>load function main.mk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function main.main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/gortti/shapes_go116</com>
  <com>option gortti on</com>
  <com>read symbols</com>
  <com>load function main.mk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function main.main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/gortti/shapes_go126</com>
  <com>option gortti off</com>
  <com>read symbols</com>
  <com>load function main.mk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function main.main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/gortti/shapes_go126</com>
  <com>option gortti on</com>
  <com>read symbols</com>
  <com>load function main.mk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function main.main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="gortti #1: off passes newobject a bare descriptor address (both images)" min="2" max="2">runtime\.newobject\(0x[0-9a-f]+\)</stringmatch>
<stringmatch name="gortti #2: go1.16 names the allocated type" min="1" max="1">runtime\.newobject\(&amp;type\.main\.Point\)</stringmatch>
<stringmatch name="gortti #3: go1.16 stores the named itab of the interface conversion" min="1" max="1">dat_[0-9a-f]+ = &amp;go\.itab\.\*main\.Point,main\.Shape;</stringmatch>
<stringmatch name="gortti #4: go1.26 names the allocated type" min="1" max="1">runtime\.newobject\(&amp;type:main\.Point\)</stringmatch>
<stringmatch name="gortti #5: go1.26 stores the named itab of the interface conversion" min="1" max="1">dat_[0-9a-f]+ = &amp;go:itab\.\*main\.Point,main\.Shape;</stringmatch>
</decompilertest>
