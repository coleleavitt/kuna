<script>
  <com>option x87depth off</com>
  <com>lo fu drop2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option x87depth on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu keep</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
