<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna (IDA 9.5 rust.so 0xd200 string-length finder): P1 external
    refinement, option strcodelen (default on). The script loads the committed
    strcodelen/strs_x86_64.elf (a no_std rustc build, source and command beside
    it). greet() passes "hello there" and "general kenobi" as (ptr, len) pairs;
    rustc lays them out back to back with no NUL, and no static record holds
    their lengths. keep() passes the first pointer alone.

    Assert #1 is the off pass: keep's pointer stays a bare address (the bytes
    run into the next literal with no NUL, so no string covers them).
    Asserts #2-#3 are the on pass: the pass bounds both literals by the lengths
    greet loads beside them, so keep's pointer alone prints only its own text
    and never the glued "hello theregeneral kenobi" (a char[N] symbol prints
    at most N bytes). Assert #4: greet's calls
    print their literals in both passes (the decompiler-side fatstr rule).
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/strcodelen/strs_x86_64.elf</com>
  <com>option strcodelen off</com>
  <com>read symbols</com>
  <com>load function greet</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function keep</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/strcodelen/strs_x86_64.elf</com>
  <com>option strcodelen on</com>
  <com>read symbols</com>
  <com>load function greet</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function keep</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="strcodelen #1: off leaves keep's pointer as an address" min="1" max="1">sink_ptr\(0x200158\);</stringmatch>
<stringmatch name="strcodelen #2: on prints keep's pointer as its own literal" min="1" max="1">sink_ptr\("hello there"\);</stringmatch>
<stringmatch name="strcodelen #3: no literal is glued to the next" min="0" max="0">hello theregeneral</stringmatch>
<stringmatch name="strcodelen #4: greet's pairs print their literals in both passes" min="2" max="2">sink\("general kenobi",0xe\);</stringmatch>
</decompilertest>
