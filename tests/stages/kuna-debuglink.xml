<binaryimage arch="x86:LE:64:default">
<!--
    Kuna #65 (personal): P1 environment binding, separate debug files
    (option debuglink, default on, a load-time gate). Fixtures from
    fixtures/debuglink/p.c as its header says. Both images are stripped:
    before, the only names were the dynamic symbol `main` and the call printed
    as sub_1149(). #1: link's .gnu_debuglink names link.debug next to it
    (CRC32 checked) and its .symtab names the calls. #2: mini carries its
    function symbols as XZ-compressed MiniDebugInfo in .gnu_debugdata.
    (The build-id path, <dir>/.build-id/xx/rest.debug under KUNA_DEBUG_DIRS,
    is the same lookup; a host directory cannot be pinned in a stage test.)
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/debuglink/link</com>
  <com>read symbols</com>
  <com>load function helper_beta</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/debuglink/mini</com>
  <com>read symbols</com>
  <com>load function helper_beta</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="debuglink #1: .gnu_debuglink names the callee" min="2" max="2">return helper_alpha\(\) \+ -3;</stringmatch>
</decompilertest>
