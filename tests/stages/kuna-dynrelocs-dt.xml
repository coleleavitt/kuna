<decompilertest>
<binaryimage arch="x86:LE:64:default">
<!--
    Kuna #64 (personal): P1 GOT synthesis for relocatable objects and
    dynamic relocations read from PT_DYNAMIC (option dynrelocs, default on).
    #1-#2: a PIC x86-64 object's GOTPCRELX/REX_GOTPCRELX and a PIC AArch64
    object's ADR_GOT_PAGE/LD64_GOT_LO12_NC go through a synthesized read-only
    GOT, so the global reads as itself (before: the field kept the assembler's
    zero and the access read dat_4803e183f9893801).
    #4-#5: an lld-linked PIE with its section headers zeroed. Before, the
    section walk found no relocation table, the RELA RELATIVE slots stayed
    zero and the call through tab[1] was (*dat_2848)(a0) (the same as
    `option dynrelocs off`, a load-time option this test does not toggle
    because it would leak into later tests). Now PT_DYNAMIC's DT_RELA fills
    them, the call resolves, and the IRELATIVE resolver is named ifunc_1790.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/relocs/x64pic.o</com>
  <com>read symbols</com>
  <com>load function pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/relocs/a64pic.o</com>
  <com>read symbols</com>
  <com>load function pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/relocs/lld-nosht.elf</com>
  <com>read symbols</com>
  <com>map function r0x1730 call_two</com>
  <com>load function call_two</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function ifunc_1790</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="dynrelocs #1: x86-64 GOTPCRELX reaches the global" min="1" max="1">dat_40004c \+= a0;</stringmatch>
<stringmatch name="dynrelocs #2: AArch64 GOT page/offset reaches the global" min="1" max="1">dat_400054 \+= a0;</stringmatch>
<stringmatch name="dynrelocs #4: on fills it from DT_RELA without section headers" min="1" max="1">sub_1690\(a0\);</stringmatch>
<stringmatch name="dynrelocs #5: the IRELATIVE resolver is a named function" min="1" max="1">ifunc_1790\(void\)</stringmatch>
</decompilertest>
