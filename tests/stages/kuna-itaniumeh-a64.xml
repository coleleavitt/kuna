<decompilertest>
<binaryimage arch="AARCH64:LE:64:v8A">
<!--
    Kuna (IDA 9.5 eh34 design): P2 flow classification, option itaniumeh
    (default off), on AArch64. The script loads the committed
    itaniumeh/eh_aarch64.so (clang++ for aarch64-linux-gnu, source eh2.cc and
    the command in the README beside it). The unwinder's registers are x0
    (exception) and x1 (selector).

    Assert #1 is the off pass: no catch code. Asserts #2-#4 are the on pass.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c0035fd6</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_aarch64.so</com>
  <com>option itaniumeh off</com>
  <com>read symbols</com>
  <com>load function catcher</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_aarch64.so</com>
  <com>option itaniumeh on</com>
  <com>read symbols</com>
  <com>load function catcher</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="itaniumeh a64 #1: off has no catch code (the one match is the on pass)" min="1" max="1">__cxa_begin_catch</stringmatch>
<stringmatch name="itaniumeh a64 #2: on gives the call an exceptional edge" min="1" max="1">if \(!eh_unwinding\(\)\)</stringmatch>
<stringmatch name="itaniumeh a64 #3: on passes x0 to __cxa_begin_catch" min="1" max="1">__cxa_begin_catch\(eh_exception\(\)\)</stringmatch>
<stringmatch name="itaniumeh a64 #4: on names the catch type and selector" min="1" max="1">landing pad: catch \(Err\) when selector == 2; catch \(\.\.\.\) when selector == 1</stringmatch>
</decompilertest>
