<script>
  <com>parse line extern uint4 mba4(uint4 x,uint4 y,uint4 z,uint4 w);</com>
  <com>parse line extern uint4 mba6(uint4 a,uint4 b,uint4 c,uint4 d,uint4 e,uint4 f);</com>
  <com>parse line extern uint4 mbapoly(uint4 x,uint4 y);</com>
  <com>option mba off</com>
  <com>lo fu mba4</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu mba6</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu mbapoly</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option mba on</com>
  <com>lo fu mba4</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu mba6</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu mbapoly</com>
  <com>decompile</com>
