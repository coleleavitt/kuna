<stringmatch name="mba groups #1: off keeps the four-leaf form" min="1" max="1">- \(x &amp; y &amp; z &amp; w\);</stringmatch>
<stringmatch name="mba groups #2: off keeps the six-leaf form" min="1" max="1">\(a \^ b\) \+ \(a &amp; b\) \* 2;</stringmatch>
<stringmatch name="mba groups #3: off keeps the polynomial form" min="1" max="1">\* \(x \| y\)</stringmatch>
<stringmatch name="mba groups #4: on folds the four-leaf group to one boolean function" min="1" max="1">return [xyzw] &amp; [xyzw] \| [xyzw] &amp; [xyzw];</stringmatch>
<stringmatch name="mba groups #5: on folds six leaves to a + b + (c | d) + (e ^ f)" min="1" max="1">return \([ef] \^ [ef]\) \+ \([cd] \| [cd]\) \+ [ab] \+ [ab];</stringmatch>
<stringmatch name="mba groups #6: on normalizes the polynomial to x * y" min="1" max="1">return [xy] \* [xy];</stringmatch>
