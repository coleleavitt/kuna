<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Swift runtime prototypes (`option swiftruntime on|off`).

    Issue: a stripped Swift binary's runtime calls carry no signature, so
    `swift_allocObject` returns a `long` and takes whatever the call site
    passes.

    Stage / sub-stage: P1 external-refinement, `SwiftRuntimePass`
    (`kuna-analysis/src/analyzers/swift/kuna_swiftruntime.rs`).

    P0 assertion: `option swiftruntime on|off` (default on).

    Both passes load the real fixture `swift_types_elf` with `swiftmetadata
    on` for the names. Pass 1 (`option swiftruntime off`): the allocating
    initializer's `swift_allocObject(self,0x28,7)` returns a `long`. Pass 2
    (the default): it takes a `swift.type_metadata *` and two sizes and
    returns the object as a `void *`.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/swift_types_elf</com>
  <com>option swiftmetadata on</com>
  <com>option swiftruntime off</com>
  <com>read symbols</com>
  <com>load addr 0x3940</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/swift_types_elf</com>
  <com>option swiftmetadata on</com>
  <com>read symbols</com>
  <com>load addr 0x3940</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="swiftruntime off: the allocation returns a bare word" min="1" max="1">int8 v1; // rax</stringmatch>
<stringmatch name="swiftruntime off: the allocation's arguments are the call site's" min="1" max="1">swift_allocObject\(self,0x28,7\)</stringmatch>
<stringmatch name="swiftruntime on: the allocation returns the object" min="1" max="1">void \*v1; // rax</stringmatch>
<stringmatch name="swiftruntime on: the allocation takes the metadata" min="1" max="1">swift_allocObject\(\(swift\.type_metadata \*\)self,0x28,7\)</stringmatch>
</decompilertest>
