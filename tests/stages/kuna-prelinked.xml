<decompilertest>
<binaryimage arch="AARCH64:LE:64:v8A:default">
<!--
    Kuna `kernelcache` option on pre-fileset (prelinked) kernelcaches (P1
    code-data partition). The fixtures come from gen_prelinked.py.

    prelinked_merged.macho is an iOS 12-14 style kernel whose pointers are
    threaded through __TEXT,__thread_starts, among them the four handlers of
    a kext's IOExternalMethodDispatch table. Pass 1 (`option kernelcache off`)
    is the bug: the table holds packed chain words, so nothing finds it and
    its handlers stay unnamed. Pass 2 (`auto`) rebases every pointer first.

    prelinked_split.macho is an iOS 11 style kernel whose stripped kext lives
    in __PRELINK_TEXT with untyped __stubs / __got. Off, the kext's stub call
    is an unnamed function; `option kernelcache Widget` cuts the kext out and
    binds the kernel's kernel_add to its __got slot and stub.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c0035fd6</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>option kernelcache off</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/prelinked_merged.macho</com>
  <com>read symbols</com>
  <com>load addr 0xfffffff007006920</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/prelinked_split.macho</com>
  <com>read symbols</com>
  <com>load addr 0xfffffff00700d000</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option kernelcache auto</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/prelinked_merged.macho</com>
  <com>read symbols</com>
  <com>load addr 0xfffffff007006920</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option kernelcache Widget</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/prelinked_split.macho</com>
  <com>read symbols</com>
  <com>load addr 0xfffffff00700d000</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option kernelcache auto</com>
  <com>quit</com>
</script>
<stringmatch name="PRELINKED #1: off leaves the threaded dispatch table unread" min="1" max="1">^[a-z ]+ sub_fffffff007006920\(</stringmatch>
<stringmatch name="PRELINKED #2: off leaves the split kext's stub call unnamed" min="1" max="1">^  sub_fffffff00700d100\(a0,8\);</stringmatch>
<stringmatch name="PRELINKED #3: auto rebases the threaded pointers and names the handler" min="1" max="1">IOExternalMethods_fffffff007008040::externalMethod_1\(</stringmatch>
<stringmatch name="PRELINKED #4: the cut-out kext's stub call names the kernel function" min="1" max="1">^  kernel_add\(a0,8\);</stringmatch>
</decompilertest>
