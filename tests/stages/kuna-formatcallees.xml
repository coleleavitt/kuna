<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Format-string typing for format functions no table declares
    (`option formatcallees on|off`, default on; program prep, the load-time
    `formatstring static` resolver).

    The fixture (fmtcallees.c beside it, gcc -O2, stripped) has a logger that
    forwards its varargs to vfprintf, a scanf-like parser that forwards to
    vsscanf, a variadic `report` that reaches vfprintf through a va_list
    helper, and a non-variadic `note(const char *)` that calls the logger.
    Nothing names them, so only their bodies say they take a format.

    Pass 1 (`option formatcallees off`) reproduces the gap: the logger's
    `%f` argument, passed in xmm0, is missing, and `%d` arguments keep the
    widths the caller computed. Pass 2 is the shipped default: each call is
    typed from its literal format, the double appears, and `note("50% done")`
    is left alone, because `note` does not test AL at its entry the way a
    System V variadic function does.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/fmtcallees_x86_64</com>
  <com>option listing on</com>
  <com>option formatcallees off</com>
  <com>read symbols</com>
  <com>load function main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/fmtcallees_x86_64</com>
  <com>option listing on</com>
  <com>read symbols</com>
  <com>load function main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="FORMATCALLEES #1: off, the logger's double argument is missing" min="1" max="1">"args=%d first=%s d=%f\\n",argc,argv\[1\]\);</stringmatch>
<stringmatch name="FORMATCALLEES #2: on, the logger's double argument is passed" min="1" max="1">"args=%d first=%s d=%f\\n",argc,argv\[1\],\(float8\)argc \* </stringmatch>
<stringmatch name="FORMATCALLEES #3: the scanf-like parser takes the two int pointers either way" min="2" max="2">"%d:%d",&amp;v\d+,&amp;v\d+\)</stringmatch>
<stringmatch name="FORMATCALLEES #4: the non-variadic note keeps its one argument" min="2" max="2">\("50% done"\);</stringmatch>
<stringmatch name="FORMATCALLEES #5: on, the %c argument is the char it is, not a widened int" min="1" max="1">c=%c\\n",v\d+,v\d+,\*argv\[1\]\);</stringmatch>
</decompilertest>
