<stringmatch name="OUTLINED #1: off keeps the stack probe call" min="1" max="1">__chkstk_darwin\(</stringmatch>
<stringmatch name="OUTLINED #2: on returns the argument kept across the probe" min="1" max="1">return (\(int4\))?a0 \+ 1;</stringmatch>
<stringmatch name="OUTLINED #3: off calls the fragment" min="1" max="1">return _OUTLINED_FUNCTION_0\(.*\) \+ 3;</stringmatch>
<stringmatch name="OUTLINED #4: on inlines the fragment's arithmetic" min="1" max="1">return \(a0 \+ a1\) \* 2 \+ 3;</stringmatch>
<stringmatch name="OUTLINED #5: off tail-calls the fragment" min="1" max="1">_OUTLINED_FUNCTION_1\(</stringmatch>
<stringmatch name="OUTLINED #6: on inlines the tail-called fragment" min="1" max="1">exit\(7\);</stringmatch>
