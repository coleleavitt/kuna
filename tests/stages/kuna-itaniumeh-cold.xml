<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna (IDA 9.5 eh34 design): P2 flow classification, option itaniumeh
    (default off), with GCC's hot/cold split. The script loads the committed
    itaniumeh/eh_x86_64_cold.elf (g++ -O2, the default partitioning, from the
    same eh.cc): catcher()'s landing pad is a two-instruction stub that jumps
    into catcher.cold, a separate FDE that is also a function entry.

    Assert #1 is the off pass: only the normal path. Asserts #2-#4 are the on
    pass: the jump out of the pad stub is followed into the cold code instead
    of being read as a tail call, so the catch bodies print in catcher().
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_x86_64_cold.elf</com>
  <com>option itaniumeh off</com>
  <com>read symbols</com>
  <com>load addr 0x4013e0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_x86_64_cold.elf</com>
  <com>option itaniumeh on</com>
  <com>read symbols</com>
  <com>load addr 0x4013e0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="itaniumeh cold #1: off shows catcher as the normal path only" min="1" max="1">void catcher\(</stringmatch>
<stringmatch name="itaniumeh cold #2: on follows the pad stub into the cold code" min="2" max="2">__cxa_begin_catch\(eh_exception\(\)\)</stringmatch>
<stringmatch name="itaniumeh cold #3: on tests the selector" min="1" max="1">if \(eh_selector\(\) == 1\)</stringmatch>
<stringmatch name="itaniumeh cold #4: the jump into catcher.cold is not a tail call" min="0" max="0">tail-call</stringmatch>
</decompilertest>
