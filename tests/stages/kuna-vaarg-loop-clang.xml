<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    kuna `vaarg` stage test (clang loop): va_arg in a loop, on a va_list local
    to the function (heritage promotes it: gp_offset and overflow_arg_area are
    loop phis) and on a va_list parameter. clang unrolls the loop by two and peels the last read.
    With vaarg off the offset tests and the register save area reads print.
    With vaarg on each read prints as va_arg(ap,T) (va_arg(a1,long) through
    the parameter) and the promoted va_list gets its va_start(ap,a0).

    Source, compiled with clang -O2 -fno-inline -fcf-protection=none, linked at
    0x100000 (flat .text):
      #include <stdarg.h>
      long sum_long(int n, ...) {
          va_list ap; long s = 0;
          va_start(ap, n);
          for (int i = 0; i < n; i++) s += va_arg(ap, long);
          va_end(ap);
          return s;
      }
      double sum_dbl(int n, ...) {
          va_list ap; double s = 0;
          va_start(ap, n);
          for (int i = 0; i < n; i++) s += va_arg(ap, double);
          va_end(ap);
          return s;
      }
      long vsum(int n, va_list ap) {
          long s = 0;
          for (int i = 0; i < n; i++) s += va_arg(ap, long);
          return s;
      }
-->
<bytechunk space="ram" offset="0x100000"></bytechunk>
<symbol space="ram" offset="0x100000" name="sum_long"/>
<symbol space="ram" offset="0x100120" name="sum_dbl"/>
<symbol space="ram" offset="0x100260" name="vsum"/>
</binaryimage>
<script>
  <com>option vaarg off</com>
  <com>lo fu sum_long</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu sum_dbl</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu vsum</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option vaarg on</com>
  <com>lo fu sum_long</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu sum_dbl</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu vsum</com>
  <com>decompile</com>
  <com>print C</com>
</script>
<stringmatch name="vaarg off: the offset tests print" min="6" max="6">0x29 &lt;=|0xa1 &lt;=</stringmatch>
<stringmatch name="vaarg off: the peeled last read tests print" min="3" max="3">&lt;= 0x28\)|&lt;= 0xa0\)</stringmatch>
<stringmatch name="vaarg on: the promoted va_list reads print as va_arg(ap,T)" min="6" max="6">va_arg\(ap,\w+\)</stringmatch>
<stringmatch name="vaarg on: the va_list parameter reads print as va_arg(a1,T)" min="3" max="3">va_arg\(a1,\w+\)</stringmatch>
<stringmatch name="vaarg on: the promoted va_list gets its va_start" min="2" max="2">va_start\(ap,a0\)</stringmatch>
</decompilertest>
