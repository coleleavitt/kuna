<stringmatch name="ARITHHELPERS #8: on, the AEABI multiply prints as an operator" min="1" max="1">return b \* a;</stringmatch>
<stringmatch name="ARITHHELPERS #9: on, the MSVC stdcall helpers print as operators over the two stack words" min="2" max="2">CONCAT44\(a1,a0\) [/%] CONCAT44\(a3,a2\)</stringmatch>
