  <com>load function _call_g</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/macho_arm64e_vcall</com>
  <com>read symbols</com>
  <com>load function _call_f</com>
  <com>decompile</com>
