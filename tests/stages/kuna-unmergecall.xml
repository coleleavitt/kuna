<stringmatch name="unmergecall #2: option off keeps pick3's single call with merged arguments (bug reproduced)" min="1" max="1">^  return f\(a1,v1\) \* 2;$</stringmatch>
<stringmatch name="unmergecall #3: option on gives pick one call per path" min="1" max="1">^    return f\(a1,1\) \+ 3;$
^  return f\(a2,2\) \+ 3;$</stringmatch>
<stringmatch name="unmergecall #4: option on gives pick3 one call per path" min="1" max="1">^    return f\(a1,7\) \* 2;$
^  if \(a0 == 2\)( // branch-flip)?$
^    return f\(a2,7\) \* 2;$
^  return f\(a1 \+ a2,9\) \* 2;$</stringmatch>
