<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna (IDA 9.5 avxlifter design, SysV vector ABI): P2/P4, options
    vexzeroupper, lanefuse and vectorabi (all default on). The script loads the
    committed vectorabi/vec_x86_64.so (gcc -O2 -mavx2 -mfma -mavx512f, source and
    command beside it).

    Asserts #1-#3 are the off pass (all three options off): no vector argument,
    the lanes of VADDPS print one by one, and the ZMM-widened ymm0 reads back
    through SUB6432. Asserts #4-#10 are the on pass: __m128/__m256/__m512
    arguments and returns, the lane run fused to _mm256_add_ps, FMA, and the
    AVX-512 merge and zero masks folded into _mm512_mask[z]_add_ps.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/vectorabi/vec_x86_64.so</com>
  <com>option vexzeroupper off</com>
  <com>option lanefuse off</com>
  <com>option vectorabi off</com>
  <com>read symbols</com>
  <com>load function addv</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function addi</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/vectorabi/vec_x86_64.so</com>
  <com>option vexzeroupper on</com>
  <com>option lanefuse on</com>
  <com>option vectorabi on</com>
  <com>read symbols</com>
  <com>load function addv</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function addi</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function fma3</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function madd</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function maddz</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function add128</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="vectorabi #1: off, addv takes and returns 8-byte scalars" min="1" max="1">^unsigned long addv\(unsigned long a0,unsigned long a1\)</stringmatch>
<stringmatch name="vectorabi #2: off, the VADDPS lanes print as scalar floats packed into a CONCAT44" min="1" max="1">return CONCAT44\(</stringmatch>
<stringmatch name="vectorabi #3: off, ymm0 is read back out of the widened zmm0" min="1" max="1">SUB6432\(</stringmatch>
<stringmatch name="vectorabi #4: on, the lane run is one intrinsic with __m256 in and out" min="1" max="1">^__m256 addv\(__m256 a0,__m256 a1\)</stringmatch>
<stringmatch name="vectorabi #5: on, addv returns the fused add" min="1" max="1">return _mm256_add_ps\(a0,a1\);</stringmatch>
<stringmatch name="vectorabi #6: on, integer vectors are __m256i" min="1" max="1">^__m256i addi\(__m256i a0,__m256i a1\)</stringmatch>
<stringmatch name="vectorabi #7: on, all three FMA vectors are arguments" min="1" max="1">return _mm256_fmadd_ps\(a0,a1,a2\);</stringmatch>
<stringmatch name="vectorabi #8: on, the merge mask folds into the intrinsic" min="1" max="1">return _mm512_mask_add_ps\(a0,a\d,a\d,a\d\);</stringmatch>
<stringmatch name="vectorabi #9: on, EVEX.z gives the zero-masking form" min="1" max="1">return _mm512_maskz_add_ps\(a\d,a\d,a\d\);</stringmatch>
<stringmatch name="vectorabi #10: on, a VEX.128 add is __m128 in and out" min="1" max="1">^__m128 add128\(__m128 a0,__m128 a1\)</stringmatch>
</decompilertest>
