<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    DWARF locals in lexical blocks and relative to the frame base
    (`option dwarfscopes on|off`), ida95-57.

    Stage P1 external-refinement. The fixtures are dwarfscopes_x86_64.c built
    with gcc -O0 -g and clang -O0 -g. `checksum` declares `char scratch[32]`
    and `int partial` inside the loop body and `long bonus` inside an if block,
    so DWARF nests them in DW_TAG_lexical_block scopes.

    Pass 1 (`dwarfscopes off`, the bug): only the direct children are read, so
    the 32-byte buffer is the anonymous `char v1 [31]`.
    Pass 2 (default, the fix): the nested buffer and loop counter are named.
    Pass 3 (clang, default): clang's frame base is RBP, not the CFA; the offsets
    are taken from it, so `total` names the accumulator and not the buffer.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>option dwarfscopes off</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dwarfscopes_gcc_O0_x86_64</com>
  <com>read symbols</com>
  <com>load function checksum</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option dwarfscopes on</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dwarfscopes_gcc_O0_x86_64</com>
  <com>read symbols</com>
  <com>load function checksum</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dwarfscopes_clang_O0_x86_64</com>
  <com>read symbols</com>
  <com>load function checksum</com>
  <com>decompile</com>
  <com>print C</com>
</script>
<stringmatch name="DWARFSCOPES #1: off, the loop-body buffer is anonymous" min="1" max="1">char v1 \[31\];</stringmatch>
<stringmatch name="DWARFSCOPES #2: on, the buffer is named and typed in both builds" min="2" max="2">char scratch \[32\];</stringmatch>
<stringmatch name="DWARFSCOPES #3: on, the loop counter is named" min="2" max="2">for \(i = 0; i &lt; rounds; i = i \+ 1\)</stringmatch>
<stringmatch name="DWARFSCOPES #4: clang's RBP frame base puts total on the accumulator, not the buffer" min="1" max="1">total = \(int4?\)strlen\(scratch\) \* \(i \+ 1\) \+ total;</stringmatch>
<stringmatch name="DWARFSCOPES #5: no build names the buffer as total" min="0" max="0">strncpy\(\(char \*\)&amp;total</stringmatch>
</decompilertest>
