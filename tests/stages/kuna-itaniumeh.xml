<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna (IDA 9.5 eh34 design): P2 flow classification, option itaniumeh
    (default off). The script loads the committed itaniumeh/eh_x86_64.elf
    (g++ -O2 -fno-reorder-blocks-and-partition, source beside it): catcher()
    catches std::runtime_error and ... around risky(); cleanup() runs a
    destructor around two calls.

    Asserts #1-#2 are the off pass: the landing pads are unreachable, so
    catcher is void and only the on pass prints __cxa_begin_catch.
    Asserts #3-#7 and #9-#10 are the on pass: each landing pad prints as a
    try region, the pads read eh_exception() and eh_selector(), the pad comment
    names the catch types, a single typed clause is catch (T &), and calls
    unwinding to one pad share its try. #8 proves a cleanup pad
    does not hand the selector register to the destructor call.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_x86_64.elf</com>
  <com>option itaniumeh off</com>
  <com>read symbols</com>
  <com>load function catcher</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function cleanup</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-cli/tests/fixtures/itaniumeh/eh_x86_64.elf</com>
  <com>option itaniumeh on</com>
  <com>read symbols</com>
  <com>load function catcher</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function cleanup</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function typed</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="itaniumeh #1: off shows catcher as the normal path only" min="1" max="1">void catcher\(</stringmatch>
<stringmatch name="itaniumeh #2: off drops the catch bodies (all three matches are the on pass's)" min="3" max="3">__cxa_begin_catch</stringmatch>
<stringmatch name="itaniumeh #3: on prints each landing pad as a try region (catcher two, cleanup one, typed one)" min="4" max="4">try \{</stringmatch>
<stringmatch name="itaniumeh #4: on tests the selector at the catch pads (catcher, typed)" min="2" max="2">if \(eh_selector\(\) == 1\)</stringmatch>
<stringmatch name="itaniumeh #5: on passes the exception to __cxa_begin_catch" min="2" max="2">__cxa_begin_catch\(eh_exception\(\)\)</stringmatch>
<stringmatch name="itaniumeh #6: on names the catch clauses by selector" min="1" max="1">landing pad: catch \(std::runtime_error\) when selector == 1; catch \(\.\.\.\) when selector == 2</stringmatch>
<stringmatch name="itaniumeh #7: on resumes unwinding from the cleanup pads and the unmatched selector" min="3" max="3">_Unwind_Resume\(eh_exception\(\)\)</stringmatch>
<stringmatch name="itaniumeh #8: the destructor keeps its one argument on both paths (one off, two on)" min="3" max="3">release\(&amp;v\d+\);</stringmatch>
<stringmatch name="itaniumeh #9: a pad with one typed clause is catch (T &amp;)" min="1" max="1">\} catch \(std::runtime_error &amp;\) \{</stringmatch>
<stringmatch name="itaniumeh #10: the second call of cleanup prints once per pass (inside the one try when on)" min="2" max="2">risky\(a0 \+ 1\);</stringmatch>
<stringmatch name="itaniumeh #11: no exceptional edge prints as a bare if" min="0" max="0">if \(!?eh_unwinding</stringmatch>
</decompilertest>
