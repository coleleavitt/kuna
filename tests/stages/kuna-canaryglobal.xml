<script>
  <com>map addr r0x220310 unsigned long __stack_chk_guard</com>
  <com>lo fu guarded</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option canaryglobal off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
