<!--
    kuna-canaryglobal: an AArch64 stack-protector canary read from the global
    __stack_chk_guard, not from a TLS slot.

    Source (clang, target aarch64-linux-gnu, -O2 -fstack-protector-all):
      int guarded(int n) { char buf[64]; return fill(buf, n & 63) + 1; }

      0x210298  sub sp,sp,#0x60 ; adrp x9,0x220000 ; ... ldr x9,[x9,#0x310]
                stur x9,[x29,#-8] ; bl fill ; adrp x8,0x220000 ; ldur x9,[x29,#-8]
                ldr x8,[x8,#0x310] ; cmp x8,x9 ; b.ne 0x2102e4 ; ... ret
      0x2102e4  bl __stack_chk_fail

    Stage: P7 edge-virtualization, `stackguard` strip extended by option
    `canaryglobal`: an unwritten read of a global named __stack_chk_guard
    (through the INDIRECT the call adds) counts as a canary source.

    Pass 1 (default) strips the compare and the __stack_chk_fail branch.
    Pass 2 (canaryglobal off) keeps them, as before.
-->
<bytechunk space="ram" offset="0x210178" readonly="true">

</bytechunk>
<bytechunk space="ram" offset="0x220310">
785634125a5a5a5a
</bytechunk>
<symbol space="ram" offset="0x210178" name="__stack_chk_fail"/>
<symbol space="ram" offset="0x21017c" name="fill"/>
<symbol space="ram" offset="0x210298" name="guarded"/>
