<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    kuna-vastart: the x86-64 SysV va_start prologue prints as one call
    (option vastart).

    Source (gcc -O2, x86-64):
      int logf_(const char *fmt, ...) {
        va_list ap;
        va_start(ap, fmt);
        int r = sink_v(fmt, ap);
        va_end(ap);
        return r;
      }

    gcc spills the five unnamed argument registers and, under test al, the
    eight XMM registers to the register save area, then sets gp_offset 8,
    fp_offset 0x30, overflow_arg_area and reg_save_area.

    Stage: P4, ActionVaStart: the four field writes become effects of a
    va_start(ap, fmt) CALLOTHER, and the save area's slots lose their forced
    liveness, so the spills go.

    Pass 1 (default) prints va_start and no spill; pass 2 (vastart off) the
    field stores and the al test.

    `varargsave` (default off) is the earlier fallback for the same prologue; this test pins it off.
-->
<bytechunk space="ram" offset="0x401000" readonly="true">

</bytechunk>
<symbol space="ram" offset="0x401030" name="logf_"/>
<symbol space="ram" offset="0x401000" name="sink_v"/>
<symbol space="ram" offset="0x401160" name="_start"/>
<symbol space="ram" offset="0x4010d0" name="sum"/>
</binaryimage>
<script>
  <com>option varargsave off</com>
  <com>lo fu logf_</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option vastart off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="KUNA-VASTART #1: the prologue is one va_start call naming the last fixed argument (default)" min="1" max="1">va_start\(&amp;\w+,\w+\);</stringmatch>
<stringmatch name="KUNA-VASTART #2: vastart off sets fp_offset field by field" min="1" max="1">= 0x30;</stringmatch>
<stringmatch name="KUNA-VASTART #3: vastart off keeps the XMM spills under the al test" min="1" max="1">if \(</stringmatch>
</decompilertest>
