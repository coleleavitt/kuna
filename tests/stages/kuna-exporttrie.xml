<!--
    Mach-O export tries, re-exports followed (`option exporttrie on|off`,
    default on).

    kuna read a Mach-O's exports from the symbol table only, and named a call
    into another dyld shared cache image after the target's own symbol. The
    export trie carries the names a stripped dylib keeps, and resolving an
    image's imports through the tries of the dylibs its two-level ordinals
    name, following EXPORT_SYMBOL_FLAGS_REEXPORT and LC_REEXPORT_DYLIB, gives
    each cross-image call the name the source used.

    Stage / sub-stage: P1 environment-binding: the Mach-O import walk
    (`macho_stubs.rs (trie_exports)`) and the dyld cache rebuild
    (`kuna_dyldcache/xrefs.rs (Names::adopt_imports_of)`), both inside
    `load file`, so the option is set before `load file`.

    Fixtures: the synthetic cache `dyld_cache_arm64e` (libcaller imports
    `_callee_entry` from libumbrella, which re-exports libcallee, whose trie
    lists `_callee_entry` as an alias of `_callee_add`), and
    `macho_trieonly_arm64`, whose symbol table was emptied so only its
    trie names `trie_scale` and `trie_entry`.

    Pass 1 (exporttrie off, the BUG): the island call is `callee_add()` and
    the stripped dylib lists `sub_298`. Pass 2 (on, the FIX): `callee_entry()`
    and `trie_scale`.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c0035fd6
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>option dyldimage /usr/lib/libcaller.dylib</com>
  <com>option exporttrie off</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dyld_cache_arm64e/dyld_shared_cache_arm64e</com>
  <com>read symbols</com>
  <com>load function caller_entry</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/macho_trieonly_arm64</com>
  <com>read symbols</com>
  <com>functions</com>
  <com>option exporttrie on</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/dyld_cache_arm64e/dyld_shared_cache_arm64e</com>
  <com>read symbols</com>
  <com>load function caller_entry</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/macho_trieonly_arm64</com>
  <com>read symbols</com>
  <com>functions</com>
  <com>quit</com>
</script>
<stringmatch name="exporttrie #1: off names the island after the target's own symbol" min="1" max="1">v1 = callee_add\(\);</stringmatch>
<stringmatch name="exporttrie #2: off leaves the stripped dylib's export unnamed" min="1" max="1">0x298 sub_298</stringmatch>
<stringmatch name="exporttrie #3: on names the island after the import, through the re-export" min="1" max="1">v1 = callee_entry\(\);</stringmatch>
