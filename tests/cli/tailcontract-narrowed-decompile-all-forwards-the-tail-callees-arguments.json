{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--addr",
    "0x21015c"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/tailcontract_fwd_aarch64",
    "binary_sha256": "973aa3daff55a6fb9d02fd8cbf9cb4fdcfd3123ae601c64225bdd76c24adb8af",
    "binary_size": 1344,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/tailcontract_fwd_aarch64",
    "selector": "0x21015c",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "target\\(a0,a1,a2,a3,a4\\); // tail-call|return target\\(a0,a1,a2,a3,a4\\);"
    ],
    "stdout_absent": [
      "target\\(\\);"
    ]
  },
  "notes": "A decompile-all that selects only forward (`b target` with every argument register untouched) has no callee-first order behind it; tailcontract states target's recovered prototype before forward's pipeline, so the tail call forwards all five arguments as `kuna decompile` and a whole-binary run print them.",
  "probe_id": "p-81800d663c5e"
}
